---
import "@/styles/globals.css";
---

<!doctype html>
<html lang="ar" dir="rtl" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>جاري إتمام تسجيل الدخول... | ArgusArGames</title>
  </head>
  <body class="flex min-h-dvh flex-col items-center justify-center bg-background text-foreground antialiased">
    <div class="flex flex-col items-center gap-4 text-center px-4">
      <div class="h-12 w-12 animate-spin rounded-full border-4 border-blue-600 border-t-transparent"></div>
      <h1 class="text-xl font-bold text-foreground">جاري إتمام تسجيل الدخول...</h1>
      <p class="text-sm text-muted">يرجى الانتظار، سيتم تحويلك تلقائياً إلى وجهتك</p>
    </div>

    <script>
      import { supabase } from "@/lib/supabase";

      async function handleAuthCallback() {
        try {
          const url = new URL(window.location.href);
          const rawNext = url.searchParams.get("next");
          const next = rawNext && rawNext.startsWith("/") ? rawNext : "/ar";
          const code = url.searchParams.get("code");

          if (code) {
            await supabase.auth.exchangeCodeForSession(code);
          }

          let done = false;
          const finish = async (user: any) => {
            if (done) return;
            done = true;
            if (user) {
              try {
                await supabase.from("profiles").upsert({
                  id: user.id,
                  email: user.email ?? null,
                  full_name:
                    user.user_metadata?.full_name ||
                    user.user_metadata?.name ||
                    user.email?.split("@")[0] ||
                    "Admin",
                  avatar_url: user.user_metadata?.avatar_url ?? null,
                  role: "admin",
                });
              } catch (profileErr) {
                console.error("Profile sync error:", profileErr);
              }
            }
            window.location.replace(next);
          };

          const { data: sessionData } = await supabase.auth.getSession();
          if (sessionData?.session?.user) {
            await finish(sessionData.session.user);
            return;
          }

          const {
            data: { subscription },
          } = supabase.auth.onAuthStateChange(async (_event, session) => {
            if (session?.user) {
              subscription.unsubscribe();
              await finish(session.user);
            }
          });

          setTimeout(() => {
            finish(null);
          }, 1500);
        } catch (err) {
          console.error("Auth callback error:", err);
          window.location.replace("/ar");
        }
      }

      // Run on DOM ready
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", handleAuthCallback);
      } else {
        handleAuthCallback();
      }
    </script>
  </body>
</html>
