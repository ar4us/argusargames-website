---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { GamesExplorer } from "@/components/games/games-explorer";
import Container from "@/components/ui/Container.astro";
import { getAllPublishedGames } from "@/lib/queries";
import { getTranslations, type Locale } from "@/lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "ar" } }, { params: { locale: "en" } }];
}

const { locale = "ar" } = Astro.params as { locale: Locale };
const t = getTranslations(locale);

const games = await getAllPublishedGames();
---

<BaseLayout
  locale={locale}
  title={t("games.title")}
  description={t("games.subtitle")}
>
  <Container className="py-12">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        {t("games.title")}
      </h1>
      <p class="mt-2 text-muted">{t("games.subtitle")}</p>
    </header>

    <GamesExplorer client:load initialGames={games} locale={locale} />
  </Container>
</BaseLayout>
