---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AdminNav } from "@/components/admin/admin-nav";
import Container from "@/components/ui/Container.astro";
import { DeleteGameButton } from "@/components/admin/confirm-delete";
import { LogoMark } from "@/components/brand/logo";
import { buttonVariants } from "@/components/ui/button";
import { Badge } from "@/components/ui/card";
import { Plus, Link2 } from "lucide-react";
import { getAllGamesForAdmin } from "@/lib/queries";
import { AdminGamesList } from "@/components/admin/admin-games-list";
import { getTranslations, type Locale } from "@/lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "ar" } }, { params: { locale: "en" } }];
}

const { locale = "ar" } = Astro.params as { locale: Locale };
const t = getTranslations(locale);
const games = await getAllGamesForAdmin();
---

<BaseLayout locale={locale} title={t("admin.games.title")}>
  <Container className="py-10">
    <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <h1 class="text-2xl font-bold tracking-tight text-foreground">
        {t("admin.title")}
      </h1>
      <a
        href={`/${locale}`}
        class="text-sm font-medium text-muted hover:text-blue-600"
      >
        {t("admin.backToSite")} →
      </a>
    </header>

    <div class="grid gap-8 lg:grid-cols-[200px_1fr]">
      <aside>
        <AdminNav client:load />
      </aside>

      <main class="min-w-0">
        <div class="mb-6 flex items-center justify-between gap-4">
          <h2 class="text-xl font-semibold tracking-tight text-foreground">
            {t("admin.games.title")}
          </h2>
          <a
            href={`/${locale}/admin/games/new`}
            class={buttonVariants({ size: "sm" })}
          >
            <Plus className="h-4 w-4" />
            <span>{t("admin.games.add")}</span>
          </a>
        </div>

        <AdminGamesList client:load initialGames={games} locale={locale} />
      </main>
    </div>
  </Container>
</BaseLayout>
