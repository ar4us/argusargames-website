---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AuthShell } from "@/components/auth/auth-shell";
import { RegisterForm } from "@/components/auth/register-form";
import { SocialButtons } from "@/components/auth/social-buttons";
import { Divider } from "@/components/auth/divider";
import { getTranslations, type Locale } from "@/lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "ar" } }, { params: { locale: "en" } }];
}

const { locale = "ar" } = Astro.params as { locale: Locale };
const t = getTranslations(locale);
---

<BaseLayout locale={locale} title={t("auth.registerTitle")}>
  <div class="py-12">
    <AuthShell client:load title={t("auth.registerTitle")} subtitle={t("auth.registerSubtitle")}>
      <SocialButtons client:load />
      <Divider client:load label={t("auth.orContinueWith")} />
      <RegisterForm client:load />
      <p class="mt-6 text-center text-sm text-muted">
        {t("auth.haveAccount")}{" "}
        <a href={`/${locale}/login`} class="font-medium text-blue-600 hover:underline">
          {t("auth.login")}
        </a>
      </p>
    </AuthShell>
  </div>
</BaseLayout>
