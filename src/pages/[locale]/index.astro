---
import HomeView from "@/components/home/HomeView.astro";
import type { Locale } from "@/lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "ar" } }, { params: { locale: "en" } }];
}

const { locale = "ar" } = Astro.params as { locale: Locale };
---

<HomeView locale={locale} />
