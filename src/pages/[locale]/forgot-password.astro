---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AuthShell } from "@/components/auth/auth-shell";
import { ForgotForm } from "@/components/auth/forgot-form";
import { getTranslations, type Locale } from "@/lib/i18n";

export function getStaticPaths() {
  return [{ params: { locale: "ar" } }, { params: { locale: "en" } }];
}

const { locale = "ar" } = Astro.params as { locale: Locale };
const t = getTranslations(locale);
---

<BaseLayout locale={locale} title={t("auth.forgotTitle")}>
  <div class="py-12">
    <AuthShell client:load title={t("auth.forgotTitle")} subtitle={t("auth.forgotSubtitle")}>
      <ForgotForm client:load />
    </AuthShell>
  </div>
</BaseLayout>
