---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameCard from "../../components/GameCard.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/ui";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return [{ params: { lang: "ar" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allGames = await getCollection("localizations", ({ id }) =>
  id.startsWith(`${lang}/`)
);
const games = allGames.sort(
  (a, b) => b.data.release_date.getTime() - a.data.release_date.getTime()
);
const featuredGame = games[0];
---

<BaseLayout>

  <!-- ══════════════════════════════════════════════════════ -->
  <!--  HERO                                                  -->
  <!-- ══════════════════════════════════════════════════════ -->
  <section class="relative min-h-[100svh] flex flex-col justify-center overflow-hidden grid-bg">

    <!-- Ambient blobs -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -start-40 w-[700px] h-[700px] rounded-full"
           style="background: radial-gradient(circle, rgba(124,92,252,0.12) 0%, transparent 70%);"></div>
      <div class="absolute top-1/2 -translate-y-1/2 -end-60 w-[600px] h-[600px] rounded-full"
           style="background: radial-gradient(circle, rgba(240,180,41,0.07) 0%, transparent 70%);"></div>
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[900px] h-[300px]"
           style="background: radial-gradient(ellipse, rgba(124,92,252,0.06) 0%, transparent 70%);"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 w-full">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center py-16 lg:py-24">

        <!-- ── Left: Text ── -->
        <div class="order-2 lg:order-1 lg:pe-8">

          <!-- Badge -->
          <div class="inline-flex items-center gap-2.5 mb-6
                      px-4 py-2 rounded-full
                      border border-[#7c5cfc]/25 bg-[#7c5cfc]/8
                      text-[#a78bfa] text-sm font-semibold">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#7c5cfc] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-[#7c5cfc]"></span>
            </span>
            {t("hero.badge")}
          </div>

          <!-- Heading -->
          <h1 class="text-[2.8rem] sm:text-[3.5rem] lg:text-[4.2rem] font-black leading-[1.05] mb-6 text-white"
              style="font-family: Cairo, sans-serif; letter-spacing: -0.02em;">
            {t("hero.title")}
            <br />
            <span class="gradient-text-violet text-glow-violet">{t("hero.title_highlight")}</span>
          </h1>

          <!-- Subtitle -->
          <p class="text-[#8b8baf] text-lg leading-relaxed mb-10 max-w-lg">
            {t("hero.subtitle")}
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap gap-3">
            <a href={`/${lang}/localizations/`}
               class="btn-download inline-flex items-center gap-2.5 px-7 py-3.5 rounded-xl text-white font-bold text-base">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zM11 13H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5S14.67 12 15.5 12s1.5.67 1.5 1.5S16.33 15 15.5 15zm3-3c-.83 0-1.5-.67-1.5-1.5S17.67 9 18.5 9s1.5.67 1.5 1.5S19.33 12 18.5 12z"/>
              </svg>
              {t("hero.cta_primary")}
            </a>
            <a href={`/${lang}/about/`}
               class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-xl
                      border border-[#1a1a35] text-[#8b8baf]
                      hover:border-[#7c5cfc]/40 hover:text-[#a78bfa] hover:bg-[#7c5cfc]/5
                      font-semibold text-base transition-all duration-200">
              {t("hero.cta_secondary")}
            </a>
          </div>

          <!-- Stats row -->
          <div class="flex items-center gap-6 mt-12 pt-8 border-t border-[#1a1a35]">
            {[
              { value: String(games.length), label: lang === "ar" ? "تعريب منشور" : "Patches" },
              { value: "100%", label: lang === "ar" ? "مجاني" : "Free" },
              { value: "AR", label: lang === "ar" ? "لغة عربية كاملة" : "Full Arabic" },
            ].map(({ value, label }) => (
              <div>
                <div class="text-2xl font-black gradient-text-violet">{value}</div>
                <div class="text-xs text-[#4a4a72] mt-0.5 font-medium">{label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- ── Right: Featured Game Card ── -->
        {featuredGame && (
          <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
            <div class="relative w-full max-w-[480px]">

              <!-- Glow behind card -->
              <div class="absolute inset-0 rounded-3xl blur-3xl opacity-30"
                   style="background: linear-gradient(135deg, #7c5cfc, #5b3ee0);"></div>

              <!-- Card -->
              <div class="relative border-gradient rounded-3xl overflow-hidden bg-[#0f0f22]">
                <!-- Cover image -->
                <div class="aspect-[16/10] overflow-hidden">
                  <img
                    src={featuredGame.data.cover}
                    alt={featuredGame.data.game}
                    class="w-full h-full object-cover"
                    style="filter: brightness(0.9) contrast(1.1);"
                  />
                  <!-- Cinematic overlay -->
                  <div class="absolute inset-0"
                       style="background: linear-gradient(to top, #0f0f22 0%, rgba(15,15,34,0.4) 50%, transparent 100%);"></div>
                </div>

                <!-- Card bottom info -->
                <div class="p-5">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <p class="text-[#8b8baf] text-xs font-medium mb-1">{featuredGame.data.game}</p>
                      <h3 class="text-white font-black text-xl leading-tight"
                          style="font-family: Cairo, sans-serif;">
                        {featuredGame.data.title}
                      </h3>
                    </div>
                    <span class={`flex-shrink-0 text-xs font-semibold px-3 py-1 rounded-full
                      ${featuredGame.data.status === 'complete' ? 'badge-complete' :
                        featuredGame.data.status === 'beta' ? 'badge-beta' : 'badge-partial'}`}>
                      {featuredGame.data.status === 'complete'
                        ? t("games.status.complete")
                        : featuredGame.data.status === 'beta'
                          ? t("games.status.beta")
                          : t("games.status.partial")}
                    </span>
                  </div>

                  <div class="mt-4 flex items-center justify-between">
                    <div class="flex items-center gap-3 text-xs text-[#4a4a72]">
                      <span class="font-mono bg-[#1a1a35] px-2 py-1 rounded text-[#8b8baf]">
                        {featuredGame.data.version}
                      </span>
                      <span>{featuredGame.data.file_size}</span>
                    </div>
                    <a
                      href={`/${lang}/localizations/${featuredGame.id.replace(`${lang}/`, "").replace(/\.md$/, "")}/`}
                      class="btn-download flex items-center gap-2 px-4 py-2 rounded-xl text-white text-sm font-bold"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 16l-5-5 1.41-1.41L11 13.17V4h2v9.17l2.59-2.58L17 11l-5 5zm-7 4v-2h14v2H5z"/>
                      </svg>
                      {t("games.download")}
                    </a>
                  </div>
                </div>
              </div>

              <!-- Floating version badge -->
              <div class="absolute -top-3 -start-3 bg-[#7c5cfc] text-white text-[11px] font-black
                          px-3 py-1.5 rounded-full shadow-lg" style="letter-spacing:0.05em;">
                NEW ✦
              </div>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Bottom fade -->
    <div class="absolute bottom-0 inset-x-0 h-32 pointer-events-none"
         style="background: linear-gradient(to top, #070711, transparent);"></div>
  </section>

  <!-- ══════════════════════════════════════════════════════ -->
  <!--  GAMES SECTION                                         -->
  <!-- ══════════════════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 py-20">

    <!-- Section header -->
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-[#7c5cfc] text-sm font-semibold mb-2 uppercase tracking-widest">
          {lang === "ar" ? "مكتبتنا" : "Our Library"}
        </p>
        <h2 class="text-2xl sm:text-3xl font-black text-white" style="font-family: Cairo, sans-serif;">
          {t("games.title")}
        </h2>
      </div>
      <a href={`/${lang}/localizations/`}
         class="hidden sm:flex items-center gap-2 text-sm text-[#8b8baf] hover:text-[#a78bfa] transition-colors font-medium">
        {t("games.all")}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="flip-rtl">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </a>
    </div>

    <!-- Grid -->
    {games.length === 0 ? (
      <div class="text-center py-32 text-[#4a4a72]">
        <div class="text-5xl mb-4">🎮</div>
        <p>{t("games.empty")}</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {games.slice(0, 6).map((game) => (
          <GameCard game={game} lang={lang} />
        ))}
      </div>
    )}
  </section>

  <!-- ══════════════════════════════════════════════════════ -->
  <!--  BANNER CTA                                            -->
  <!-- ══════════════════════════════════════════════════════ -->
  <section class="max-w-7xl mx-auto px-5 sm:px-8 pb-24">
    <div class="relative overflow-hidden rounded-3xl border border-[#7c5cfc]/20 bg-[#0d0d1f]">
      <!-- BG glow -->
      <div class="absolute inset-0 pointer-events-none"
           style="background: radial-gradient(ellipse at 60% 50%, rgba(124,92,252,0.12) 0%, transparent 70%);"></div>

      <div class="relative z-10 p-10 sm:p-14 flex flex-col sm:flex-row items-center justify-between gap-8">
        <div>
          <h3 class="text-2xl sm:text-3xl font-black text-white mb-2" style="font-family: Cairo, sans-serif;">
            {lang === "ar" ? "ألعابك تستحق العربية" : "Your Games Deserve Arabic"}
          </h3>
          <p class="text-[#8b8baf] text-base max-w-md">
            {lang === "ar"
              ? "جميع التعريبات مجانية 100٪ وتحميل مباشر بدون تسجيل."
              : "All patches are 100% free with direct download, no registration required."}
          </p>
        </div>
        <a href={`/${lang}/localizations/`}
           class="btn-download flex-shrink-0 inline-flex items-center gap-3 px-8 py-4 rounded-2xl text-white font-black text-base whitespace-nowrap">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 16l-5-5 1.41-1.41L11 13.17V4h2v9.17l2.59-2.58L17 11l-5 5zm-7 4v-2h14v2H5z"/>
          </svg>
          {t("hero.cta_primary")}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
