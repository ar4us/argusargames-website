---

<footer class="relative border-t border-[#1a1a35] mt-10">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[#7c5cfc]/30 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-10">
    <div class="flex flex-col items-center gap-8">

      <!-- Brand row -->
      <div class="flex flex-col sm:flex-row items-center justify-between w-full gap-6">

        <!-- Logo -->
        <div class="flex items-center gap-3">
          <div class="relative w-8 h-8">
            <div class="absolute inset-0 rounded-xl bg-gradient-to-br from-[#7c5cfc] to-[#5b3ee0]"></div>
            <div class="absolute inset-0 rounded-xl flex items-center justify-center">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M12 2L2 7v10l10 5 10-5V7L12 2z" stroke="white" stroke-width="1.5" stroke-linejoin="round" fill="rgba(255,255,255,0.15)"/>
                <path d="M12 2v15M2 7l10 5 10-5" stroke="white" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
          <div>
            <span class="font-black text-white" style="font-family: Cairo, sans-serif;">بالعربي</span>
            <span class="text-[10px] text-[#7c5cfc] font-bold tracking-widest ms-1.5 uppercase">Games</span>
          </div>
        </div>

        <!-- ── Social Icons ── -->
        <div class="flex items-center gap-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.name}
              title={s.name}
              class="w-10 h-10 rounded-xl flex items-center justify-center
                     text-[#4a4a72] border border-[#1a1a35]
                     hover:text-white hover:border-[#7c5cfc]/50 hover:bg-[#7c5cfc]/10
                     transition-all duration-200 group"
            >
              <span set:html={s.icon} class="group-hover:scale-110 transition-transform duration-200" />
            </a>
          ))}
        </div>

        <!-- Copyright -->
        <p class="text-xs text-[#4a4a72] text-center sm:text-end">
          © {year} بالعربي Games — {t("footer.rights")}
        </p>
      </div>

      <!-- Disclaimer -->
      <p class="text-[11px] text-[#4a4a72] text-center max-w-lg border-t border-[#1a1a35] pt-6 w-full">
        {t("footer.disclaimer")}
      </p>

    </div>
  </div>
</footer>
