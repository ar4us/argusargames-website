---
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang = lang === "ar" ? "en" : "ar";
const currentPath = Astro.url.pathname;
const alternatePath = currentPath.replace(`/${lang}/`, `/${otherLang}/`);

const navLinks = [
  { href: `/${lang}/`, label: t("nav.home") },
  { href: `/${lang}/localizations/`, label: t("nav.localizations") },
  { href: `/${lang}/about/`, label: t("nav.about") },
];
---

<header class="fixed top-0 inset-x-0 z-50">
  <!-- Top accent line -->
  <div class="h-px bg-gradient-to-r from-transparent via-[#7c5cfc] to-transparent opacity-60"></div>

  <!-- Nav bar -->
  <nav class="glass border-b border-white/[0.04]">
    <div class="max-w-7xl mx-auto px-5 sm:px-8">
      <div class="flex items-center justify-between h-[64px]">

        <!-- ── Logo ── -->
        <a href={`/${lang}/`} class="flex items-center gap-3 group flex-shrink-0">
          <div class="relative w-9 h-9">
            <div class="absolute inset-0 rounded-xl bg-gradient-to-br from-[#7c5cfc] to-[#5b3ee0] glow-violet group-hover:scale-110 transition-transform duration-300"></div>
            <div class="absolute inset-0 rounded-xl flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 7v10l10 5 10-5V7L12 2z" stroke="white" stroke-width="1.5" stroke-linejoin="round" fill="rgba(255,255,255,0.1)"/>
                <path d="M12 2v15M2 7l10 5 10-5" stroke="white" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
          <div class="leading-[1.1]">
            <div class="text-[17px] font-black text-white tracking-tight" style="font-family: Cairo, sans-serif;">
              بالعربي
            </div>
            <div class="text-[10px] font-semibold tracking-[0.2em] uppercase text-[#7c5cfc]">GAMES</div>
          </div>
        </a>

        <!-- ── Nav links (desktop) ── -->
        <div class="hidden md:flex items-center">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="relative px-4 py-2 text-sm font-medium text-[#8b8baf] hover:text-white transition-colors duration-200 group"
            >
              {link.label}
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-px bg-[#7c5cfc] group-hover:w-3/4 transition-all duration-300 rounded-full"></span>
            </a>
          ))}
        </div>

        <!-- ── Right side ── -->
        <div class="flex items-center gap-3">
          <!-- Language switcher -->
          <a
            href={alternatePath}
            class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold
                   border border-[#1a1a35] text-[#8b8baf]
                   hover:border-[#7c5cfc]/50 hover:text-[#a78bfa] hover:bg-[#7c5cfc]/5
                   transition-all duration-200"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="opacity-70">
              <path d="M12.87 15.07l-2.54-2.51.03-.03A17.52 17.52 0 0014.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"/>
            </svg>
            {t("nav.lang")}
          </a>

          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            class="md:hidden w-9 h-9 flex items-center justify-center rounded-lg border border-[#1a1a35] text-[#8b8baf] hover:text-white hover:border-[#7c5cfc]/50 transition-all"
            aria-label="Menu"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
            </svg>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-white/[0.04]">
      <div class="px-5 py-3 space-y-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="block px-3 py-2.5 rounded-lg text-sm text-[#8b8baf] hover:text-white hover:bg-white/[0.04] transition-all"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<!-- Spacer for fixed header -->
<div class="h-[65px]"></div>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
