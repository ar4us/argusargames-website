---
import { useTranslations, type Lang } from "../i18n/ui";
import type { CollectionEntry } from "astro:content";

interface Props {
  game: CollectionEntry<"localizations">;
  lang: Lang;
}

const { game, lang } = Astro.props;
const t = useTranslations(lang);
const { title, cover, version, status, file_size, game: gameName } = game.data;

const badgeClass = {
  complete: "badge-complete",
  beta:     "badge-beta",
  partial:  "badge-partial",
}[status];

const statusLabel = {
  complete: t("games.status.complete"),
  beta:     t("games.status.beta"),
  partial:  t("games.status.partial"),
}[status];

const slug = game.id.replace(`${lang}/`, "").replace(/\.md$/, "");
---

<a
  href={`/${lang}/localizations/${slug}/`}
  class="game-card group relative flex flex-col rounded-2xl overflow-hidden
         bg-[#0f0f22] border border-[#1a1a35]
         hover:border-[#7c5cfc]/40"
>
  <!-- Cover -->
  <div class="relative overflow-hidden aspect-[16/10]">
    <img
      src={cover}
      alt={gameName}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.06]"
      loading="lazy"
    />
    <!-- Gradient overlay -->
    <div class="absolute inset-0"
         style="background: linear-gradient(to top, #0f0f22 0%, rgba(15,15,34,0.2) 60%, transparent 100%);"></div>

    <!-- Status badge (top right) -->
    <div class="absolute top-3 end-3">
      <span class={`text-[11px] font-bold px-2.5 py-1 rounded-full ${badgeClass}`}>
        {statusLabel}
      </span>
    </div>

    <!-- Hover overlay -->
    <div class="absolute inset-0 bg-[#7c5cfc]/0 group-hover:bg-[#7c5cfc]/10 transition-all duration-300"></div>
  </div>

  <!-- Body -->
  <div class="flex flex-col flex-1 p-4">
    <p class="text-[#4a4a72] text-[11px] font-medium mb-1 uppercase tracking-wider">{gameName}</p>
    <h3 class="text-white font-black text-base leading-snug mb-3 group-hover:text-[#a78bfa] transition-colors"
        style="font-family: Cairo, sans-serif;">
      {title}
    </h3>

    <!-- Footer row -->
    <div class="mt-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="font-mono text-xs bg-[#1a1a35] text-[#8b8baf] px-2 py-1 rounded-lg">
          {version}
        </span>
        <span class="text-xs text-[#4a4a72]">{file_size}</span>
      </div>

      <span class="flex items-center gap-1.5 text-xs font-bold text-[#7c5cfc] group-hover:text-[#a78bfa] transition-colors">
        {t("games.download")}
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="flip-rtl">
          <path d="M12 16l-5-5 1.41-1.41L11 13.17V4h2v9.17l2.59-2.58L17 11l-5 5zm-7 4v-2h14v2H5z"/>
        </svg>
      </span>
    </div>
  </div>

  <!-- Bottom accent line on hover -->
  <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[#7c5cfc] to-transparent
              scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-center"></div>
</a>
