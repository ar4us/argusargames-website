---
import { cn } from "@/lib/utils";

interface Props {
  className?: string;
  class?: string;
  [key: string]: any;
}

const { className, class: classProp, ...props } = Astro.props;
---

<div class={cn("mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8", className, classProp)} {...props}>
  <slot />
</div>
